POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=netpath
POSTGRES_PORT=5432

# Update this when API server is added
DATABASE_URL=postgres://postgres:postgres@localhost:5432/netpath

# Frontend-to-backend base URL
VITE_API_URL=http://localhost:4000/api/v1

# Google OAuth
GOOGLE_CLIENT_ID=replace_with_google_oauth_web_client_id
VITE_GOOGLE_CLIENT_ID=replace_with_google_oauth_web_client_id

# Set real value locally only; never commit real key
OPENAI_API_KEY=replace_me